# Required: generate a private token before API startup; never commit a real token.
BACKYARD_API_TOKEN=
# One shared systemd environment file. Install as /etc/backyard/backyard.env.
# Plain KEY=value or quoted single-line values; no export or shell expansion.
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8010
BACKYARD_MONITOR_API_URL=http://127.0.0.1:8010

BACKYARD_MONITOR_DEVICE=plughw:CARD=Device,DEV=0
BACKYARD_MONITOR_RATE=48000
BACKYARD_MONITOR_CHANNELS=1
BACKYARD_MONITOR_WINDOW=3.0
BACKYARD_MONITOR_OVERLAP=1.5
BACKYARD_MONITOR_THRESHOLD=0.60
BACKYARD_MONITOR_RING_SECONDS=60
BACKYARD_MONITOR_PRE_ROLL=1
BACKYARD_MONITOR_POST_ROLL=1
BACKYARD_MONITOR_INFERENCE_QUEUE=4
BACKYARD_MONITOR_POLICY_QUEUE=4
BACKYARD_MONITOR_CLIP_QUEUE=32
BACKYARD_MONITOR_OUTBOUND_QUEUE=16
BACKYARD_MONITOR_HTTP_TIMEOUT=2
BACKYARD_MONITOR_ATTEMPTS=3
BACKYARD_MONITOR_STATUS_SECONDS=30
BACKYARD_MONITOR_INFERENCE_TIMEOUT=60
BACKYARD_MONITOR_LOCK_FILE=/home/cpvb86/Backyard/data/monitor.lock
BACKYARD_MONITOR_CAPTURE_ONLY=0
BIRDNET_APP_DATA=/home/cpvb86/Backyard/.detector-test/model-cache

# Required for production monitoring. Fill in your actual decimal coordinates.
BACKYARD_MONITOR_GEOGRAPHY=1
BACKYARD_MONITOR_LATITUDE=
BACKYARD_MONITOR_LONGITUDE=

# Keep existing API .env database/storage settings and root policy.json.
# Only set overrides below when they match your existing data/configuration.
# Environment overrides API .env. Do not accidentally point at a new empty DB.
# BACKYARD_DATABASE_PATH=/home/cpvb86/Backyard/data/backyard.sqlite3
# BACKYARD_STORAGE_ROOT=/home/cpvb86/Backyard/data
# BACKYARD_POLICY_PATH=/home/cpvb86/Backyard/policy.json

# Optional Generator: automatic missing-asset generation after accepted observations.
# Without a key, observations still work; Generator reports not configured.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_QUALITY=medium

# Optional manual Samsung Frame CLI; no timer or API/Avian integration.
BACKYARD_SAMSUNG_FRAME_HOST=
# Normally leave empty: approve pairing on TV; token is then saved privately.
BACKYARD_SAMSUNG_FRAME_TOKEN=
BACKYARD_SAMSUNG_FRAME_TOKEN_PATH=data/samsung_frame/token
BACKYARD_SAMSUNG_FRAME_STATE_PATH=data/samsung_frame/artwork.json
BACKYARD_SAMSUNG_FRAME_IMAGE_PATH=data/samsung_frame/samsung-frame.png
BACKYARD_SAMSUNG_FRAME_TIMEOUT=60

# Optional one-shot collage export; timer remains disabled until visual approval.
BACKYARD_AVIAN_EXPORT_HOURS=24
BACKYARD_AVIAN_EXPORT_MAX_UPSCALE=1.5
BACKYARD_AVIAN_EXPORT_TIMEOUT=180
# On Debian/Pi use the existing distro Chromium executable:
# BACKYARD_AVIAN_EXPORT_CHROMIUM_PATH=/usr/bin/chromium

[Unit]
Description=Backyard synchronize changed Avian PNG to Samsung Art Mode
Wants=network-online.target
After=network-online.target backyard-collage-export.service
RequiresMountsFor=/home/cpvb86/Backyard

[Service]
Type=oneshot
User=cpvb86
WorkingDirectory=/home/cpvb86/Backyard
# Settings loads /home/cpvb86/Backyard/.env, exactly like the manual CLI.
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/cpvb86/Backyard/.venv/bin/python -m app.modules.samsung_frame sync
TimeoutStartSec=10min
TimeoutStopSec=15s
KillMode=control-group
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backyard-samsung-frame

[Unit]
Description=Backyard BirdNET-Go bat observation bridge
Wants=backyard-api.service network-online.target
After=backyard-api.service network-online.target
RequiresMountsFor=/home/cpvb86/Backyard
StartLimitIntervalSec=0

[Service]
Type=exec
User=cpvb86
WorkingDirectory=/home/cpvb86/Backyard
EnvironmentFile=/etc/backyard/backyard.env
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Amsterdam
ExecStartPre=/home/cpvb86/Backyard/.venv/bin/python -m operations.wait_api --timeout 60 --check-policy
ExecStart=/home/cpvb86/Backyard/.venv/bin/python -m detector.bat_bridge
Restart=on-failure
RestartSec=30s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
MemoryAccounting=yes
CPUAccounting=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backyard-bats

[Install]
WantedBy=multi-user.target

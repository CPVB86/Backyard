# Required: generate a private token before API startup; never commit a real token.
BACKYARD_API_TOKEN=
# Relative paths resolve against the project root.
BACKYARD_DATABASE_PATH=data/backyard.sqlite3
BACKYARD_LOG_LEVEL=INFO
# Move this directory as a whole to relocate audio (e.g. NVMe).
BACKYARD_STORAGE_ROOT=data
# Maximum raw WAV upload size: 8 MiB; configurable 1 KiB to 64 MiB.
BACKYARD_MAX_AUDIO_BYTES=8388608

# Optional shared policy; also export this variable for the detector.
# BACKYARD_POLICY_PATH=policy.json

# Optional Generator credentials: export OPENAI_API_KEY in the process environment
# (production: /etc/backyard/backyard.env), not in this application .env.
# See docs/GENERATOR.md for model/quality and explicit generation.

# Samsung Frame sync CLI/timer; uses this project .env.
BACKYARD_SAMSUNG_FRAME_HOST=
# Normally leave empty: approve pairing on TV; token is then saved privately.
BACKYARD_SAMSUNG_FRAME_TOKEN=
BACKYARD_SAMSUNG_FRAME_TOKEN_PATH=data/samsung_frame/token
BACKYARD_SAMSUNG_FRAME_STATE_PATH=data/samsung_frame/artwork.json
BACKYARD_SAMSUNG_FRAME_IMAGE_PATH=data/samsung_frame/samsung-frame.png
BACKYARD_SAMSUNG_FRAME_TIMEOUT=60

# Avian export at :00/:15/:30/:45; Samsung sync at :02/:17/:32/:47.
BACKYARD_AVIAN_EXPORT_HOURS=24
BACKYARD_AVIAN_EXPORT_MAX_UPSCALE=1.5
BACKYARD_AVIAN_EXPORT_TIMEOUT=180
# On Debian/Pi use the existing distro Chromium executable:
# BACKYARD_AVIAN_EXPORT_CHROMIUM_PATH=/usr/bin/chromium
